---
import InquiryButton from "../InquiryButton.astro";
import { t, routes, type Lang } from "../../i18n/ui";
import { pickLocale, type Artwork } from "../../lib/sanity";
import { urlForImage } from "../../lib/urlForImage";
import { getSiteSettings } from "../../lib/queries";

interface Props {
  artwork: Artwork;
  lang: Lang;
}

const { artwork, lang } = Astro.props;
const r = routes[lang];
const settings = await getSiteSettings();
const title = pickLocale(artwork.title, lang);
const medium = pickLocale(artwork.medium, lang);
const description = pickLocale(artwork.description, lang);
const dim = `${artwork.width_cm} × ${artwork.height_cm} cm`;
const altText = `${title}, ${medium}, ${artwork.year}, ${dim}`;
const url = new URL(`${r.artworks}/${artwork.slug}`, Astro.site).toString();

const seriesData = artwork.series ?? null;

const imgBuilder = urlForImage(artwork.image);
const detailSrc = imgBuilder ? imgBuilder.width(1600).url() : "";
const detailSrcset = imgBuilder
  ? `${imgBuilder.width(800).url()} 800w, ${imgBuilder.width(1200).url()} 1200w, ${imgBuilder.width(1600).url()} 1600w, ${imgBuilder.width(2000).url()} 2000w`
  : "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  name: title,
  creator: { "@type": "Person", name: "Amar Aziz" },
  artMedium: medium,
  width: { "@type": "Distance", name: `${artwork.width_cm} cm` },
  height: { "@type": "Distance", name: `${artwork.height_cm} cm` },
  dateCreated: String(artwork.year),
  image: detailSrc,
  url,
  description,
};
---

<article
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16 sm:pb-24 grid gap-8 sm:gap-10 lg:gap-16 lg:grid-cols-[1.4fr_1fr]"
>
  <figure class="m-0">
    <div class="bg-[var(--color-border)] overflow-hidden">
      {detailSrc && (
        <img
          src={detailSrc}
          srcset={detailSrcset}
          sizes="(min-width: 1024px) 60vw, 100vw"
          alt={altText}
          width="1600"
          height="1600"
          class="w-full h-auto object-contain"
          onerror="this.style.display='none';this.parentElement.dataset.placeholder='1'"
        />
      )}
    </div>
  </figure>

  <div class="space-y-8 lg:pt-4">
    <p class="text-sm">
      <a href={r.artworks} class="text-[var(--color-muted)]">
        {t(lang, "detail.back")}
      </a>
    </p>

    <header class="space-y-3">
      <h1 class="font-display text-[clamp(1.875rem,5vw,3rem)] leading-tight">
        {title}
      </h1>
      <p class="text-[var(--color-muted)] font-display italic">{artwork.year}</p>
    </header>

    <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-[var(--color-muted)]">{t(lang, "detail.medium")}</dt>
      <dd>{medium}</dd>

      <dt class="text-[var(--color-muted)]">{t(lang, "detail.dimensions")}</dt>
      <dd>{dim}</dd>

      <dt class="text-[var(--color-muted)]">{t(lang, "detail.year")}</dt>
      <dd>{artwork.year}</dd>

      {
        seriesData && (
          <>
            <dt class="text-[var(--color-muted)]">
              {t(lang, "detail.series")}
            </dt>
            <dd>{pickLocale(seriesData.title, lang)}</dd>
          </>
        )
      }

      <dt class="text-[var(--color-muted)]">{t(lang, "detail.status")}</dt>
      <dd class:list={[artwork.available ? "" : "text-[var(--color-accent)]"]}>
        {
          artwork.available
            ? t(lang, "detail.status.available")
            : t(lang, "detail.status.sold")
        }
      </dd>
    </dl>

    <p class="text-base leading-relaxed max-w-[var(--container-prose)]">
      {description}
    </p>

    <InquiryButton
      lang={lang}
      title={title}
      year={artwork.year}
      medium={medium}
      dimensions={dim}
      url={url}
      available={artwork.available}
      email={settings.email}
      phoneRaw={settings.phoneRaw}
    />
  </div>
</article>

<script
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
  is:inline
/>

<style>
  div[data-placeholder="1"] {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
  }
  div[data-placeholder="1"]::after {
    content: "—";
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 4rem;
  }
</style>
