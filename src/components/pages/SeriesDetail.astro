---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import ArtworkCard from "../ArtworkCard.astro";
import { t, routes, type Lang } from "../../i18n/ui";

interface Props {
  series: CollectionEntry<"series">;
  lang: Lang;
}

const { series, lang } = Astro.props;
const r = routes[lang];
const data = series.data;
const title = data.title[lang];
const statement = data.statement[lang];

const allArtworks = await getCollection("artworks");
const works = allArtworks
  .filter((a) => a.data.series?.id === series.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<section
  class="max-w-[var(--container-page)] mx-auto px-6 pt-12 md:pt-16 pb-10"
>
  <p class="text-sm mb-6">
    <a href={r.series} class="text-[var(--color-muted)]">
      ← {t(lang, "nav.series")}
    </a>
  </p>
  <h1 class="font-display text-4xl md:text-6xl mb-6">{title}</h1>
  <p class="max-w-[var(--container-prose)] text-lg text-[var(--color-muted)]">
    {statement}
  </p>
</section>

<section class="max-w-[var(--container-page)] mx-auto px-6 pb-24">
  <h2 class="font-display text-2xl md:text-3xl mb-8">
    {t(lang, "series.works")}
  </h2>
  {
    works.length === 0 ? (
      <p class="text-[var(--color-muted)]">{t(lang, "series.works.empty")}</p>
    ) : (
      <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
        {works.map((artwork) => (
          <li>
            <ArtworkCard artwork={artwork} lang={lang} />
          </li>
        ))}
      </ul>
    )
  }
</section>
