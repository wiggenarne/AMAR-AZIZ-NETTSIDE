---
import { routes, type Lang } from "../../i18n/ui";
import {
  getArtworks,
  getSeries,
  getSiteContent,
} from "../../sanity/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = routes[lang];

const [allSeries, allArtworks, site] = await Promise.all([
  getSeries(),
  getArtworks(),
  getSiteContent(),
]);
const sorted = allSeries.sort((a, b) => a.data.order - b.data.order);

const countBySeries = new Map<string, number>();
for (const art of allArtworks) {
  if (art.data.series) {
    const id = art.data.series.id;
    countBySeries.set(id, (countBySeries.get(id) ?? 0) + 1);
  }
}

const worksLabel = lang === "no" ? "verk" : "works";
---

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 md:pt-20 pb-8 sm:pb-12"
>
  <h1 class="font-display text-[clamp(2.25rem,7vw,4rem)] mb-5 sm:mb-6">
    {site.seriesIndexTitle[lang]}
  </h1>
  <p
    class="max-w-[var(--container-prose)] text-base sm:text-lg text-[var(--color-muted)]"
  >
    {site.seriesIndexIntro[lang]}
  </p>
</section>

<section class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pb-16 sm:pb-24">
  <ul class="grid gap-10 sm:gap-12 md:grid-cols-2 list-none p-0">
    {
      sorted.map((s) => {
        const count = countBySeries.get(s.id) ?? 0;
        return (
          <li>
            <article class="space-y-3">
              <h2 class="font-display text-xl sm:text-2xl md:text-3xl">
                <a href={`${r.series}/${s.id}`} class="no-underline">
                  {s.data.title[lang]}
                </a>
              </h2>
              <p class="text-[var(--color-muted)] max-w-[var(--container-prose)]">
                {s.data.statement[lang]}
              </p>
              <p class="text-sm text-[var(--color-muted)]">
                {count} {worksLabel}
              </p>
            </article>
          </li>
        );
      })
    }
  </ul>
</section>
