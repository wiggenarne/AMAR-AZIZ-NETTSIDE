---
import { type Lang } from "../../i18n/ui";
import { getArtistInfo } from "../../sanity/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const artist = await getArtistInfo();

const subject = lang === "no" ? "Forespørsel om kunstverk" : "Artwork inquiry";
const mailto = `mailto:${artist.email}?subject=${encodeURIComponent(subject)}`;
const emailButton = lang === "no" ? "Send e-post" : "Send email";
const phoneButton = lang === "no" ? "Ring kunstneren" : "Call the artist";
---

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 md:pt-20 pb-8 sm:pb-12"
>
  <h1 class="font-display text-[clamp(2.25rem,7vw,4rem)] mb-5 sm:mb-6">
    {artist.contactHeading[lang]}
  </h1>
  <p
    class="max-w-[var(--container-prose)] text-base sm:text-lg text-[var(--color-muted)] mb-8 sm:mb-10"
  >
    {artist.contactIntro[lang]}
  </p>

  <p class="flex flex-wrap gap-3 sm:gap-4">
    <a
      href={mailto}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
    >
      {emailButton}
    </a>
    <a
      href={`tel:${artist.phoneRaw}`}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    >
      {phoneButton}
    </a>
  </p>
</section>

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-[var(--color-border)] grid gap-10 sm:gap-12 sm:grid-cols-2 lg:grid-cols-3"
>
  <div>
    <h2
      class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
    >
      {artist.contactEmailLabel[lang]}
    </h2>
    <p class="font-display text-lg">
      <a href={`mailto:${artist.email}`}>{artist.email}</a>
    </p>
  </div>

  <div>
    <h2
      class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
    >
      {artist.contactPhoneLabel[lang]}
    </h2>
    <p class="font-display text-lg">
      <a href={`tel:${artist.phoneRaw}`}>{artist.phone}</a>
    </p>
  </div>

  <address class="not-italic">
    <h2
      class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
    >
      {artist.contactAddressLabel[lang]}
    </h2>
    <p class="font-display text-lg leading-snug">
      {artist.name}<br />
      {artist.addressStreet}<br />
      {artist.addressPostalCode} {artist.addressCity}<br />
      {artist.addressCountry}
    </p>
  </address>
</section>

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-[var(--color-border)]"
>
  <h2
    class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
  >
    {artist.contactSocialLabel[lang]}
  </h2>
  <ul class="flex flex-wrap gap-6 list-none p-0">
    {
      artist.social.map((s) => (
        <li>
          <a href={s.url} rel="me noopener" target="_blank">
            {s.label} ↗
          </a>
        </li>
      ))
    }
  </ul>
</section>
