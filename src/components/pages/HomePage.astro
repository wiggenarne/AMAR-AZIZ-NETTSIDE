---
import ArtworkCard from "../ArtworkCard.astro";
import { routes, type Lang } from "../../i18n/ui";
import {
  getArtworks,
  getSeries,
  getSiteContent,
  getArtistInfo,
} from "../../sanity/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = routes[lang];

const [allArtworks, allSeries, site, artist] = await Promise.all([
  getArtworks(),
  getSeries(),
  getSiteContent(),
  getArtistInfo(),
]);

const byOrder = [...allArtworks].sort(
  (a, b) => a.data.order - b.data.order,
);
const explicitlyFeatured = byOrder.filter((a) => a.data.featured);
const featured = (explicitlyFeatured.length ? explicitlyFeatured : byOrder).slice(0, 4);

const heroArtwork =
  allArtworks.find((a) => a.id === "moonlight") ??
  explicitlyFeatured[0] ??
  byOrder[0];

const sortedSeries = allSeries.sort((a, b) => a.data.order - b.data.order);

const subject = lang === "no" ? "Forespørsel om kunstverk" : "Artwork inquiry";
---

<section
  aria-labelledby="hero-tittel"
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 md:pt-24 pb-14 sm:pb-20"
>
  <p
    class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4 sm:mb-6"
  >
    {site.heroEyebrow[lang]}
  </p>
  <h1
    id="hero-tittel"
    class="font-display text-[clamp(2.75rem,10vw,8rem)] leading-[0.95] tracking-tight mb-6 sm:mb-8"
  >
    {artist.name}
  </h1>
  <p
    class="max-w-[var(--container-prose)] text-base sm:text-lg md:text-xl text-[var(--color-muted)] mb-8 sm:mb-10"
  >
    {site.heroLede[lang]}
  </p>

  {
    heroArtwork && (
      <figure class="mb-10">
        <a
          href={`${r.artworks}/${heroArtwork.id}`}
          class="block no-underline group"
        >
          <div class="aspect-square w-full bg-[var(--color-border)] overflow-hidden">
            <img
              src={heroArtwork.data.image}
              alt={`${heroArtwork.data.title[lang]}, ${heroArtwork.data.medium[lang]}, ${heroArtwork.data.year}`}
              width="1600"
              height="1600"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
              fetchpriority="high"
              loading="eager"
              onerror="this.style.display='none';this.parentElement.dataset.placeholder='1'"
            />
          </div>
        </a>
        <figcaption class="mt-3 text-sm text-[var(--color-muted)] font-display italic">
          {heroArtwork.data.title[lang]}, {heroArtwork.data.year} – {heroArtwork.data.medium[lang]}, {heroArtwork.data.width_cm} × {heroArtwork.data.height_cm} cm
        </figcaption>
      </figure>
    )
  }

  <p class="flex flex-wrap gap-3 sm:gap-4">
    <a
      href={r.artworks}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
    >
      {site.heroCtaPrimary[lang]}
    </a>
    <a
      href={r.contact}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    >
      {site.heroCtaSecondary[lang]}
    </a>
  </p>
</section>

<section
  aria-labelledby="om-tittel"
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-14 sm:py-20 border-t border-[var(--color-border)]"
>
  <h2 id="om-tittel" class="font-display text-2xl sm:text-3xl md:text-4xl mb-5 sm:mb-6">
    {site.homeAboutTitle[lang]}
  </h2>
  <p
    class="max-w-[var(--container-prose)] text-lg text-[var(--color-muted)] mb-6"
  >
    {site.homeAboutBody[lang]}
  </p>
  <p>
    <a href={r.about}>{site.homeAboutMore[lang]} →</a>
  </p>
</section>

<section
  aria-labelledby="serier-tittel"
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-14 sm:py-20 border-t border-[var(--color-border)]"
>
  <h2 id="serier-tittel" class="font-display text-2xl sm:text-3xl md:text-4xl mb-8 sm:mb-10">
    {site.homeSeriesTitle[lang]}
  </h2>
  <ul class="grid gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
    {
      sortedSeries.map((s) => (
        <li>
          <article class="space-y-2">
            <h3 class="font-display text-xl">
              <a href={`${r.series}/${s.id}`} class="no-underline">
                {s.data.title[lang]}
              </a>
            </h3>
            <p class="text-[var(--color-muted)]">{s.data.statement[lang]}</p>
          </article>
        </li>
      ))
    }
  </ul>
</section>

{
  featured.length > 0 && (
    <section
      aria-labelledby="siste-tittel"
      class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-14 sm:py-20 border-t border-[var(--color-border)]"
    >
      <h2 id="siste-tittel" class="font-display text-2xl sm:text-3xl md:text-4xl mb-8 sm:mb-10">
        {site.homeLatestTitle[lang]}
      </h2>
      <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4 list-none p-0">
        {featured.map((artwork) => (
          <li>
            <ArtworkCard artwork={artwork} lang={lang} />
          </li>
        ))}
      </ul>
      <p class="mt-10">
        <a href={r.artworks}>{site.homeLatestViewAll[lang]} →</a>
      </p>
    </section>
  )
}

<section
  aria-labelledby="kontakt-tittel"
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-14 sm:py-20 border-t border-[var(--color-border)]"
>
  <h2 id="kontakt-tittel" class="font-display text-2xl sm:text-3xl md:text-4xl mb-5 sm:mb-6">
    {site.homeContactTitle[lang]}
  </h2>
  <p
    class="max-w-[var(--container-prose)] text-lg text-[var(--color-muted)] mb-8"
  >
    {site.homeContactBody[lang]}
  </p>
  <p class="flex flex-wrap gap-4">
    <a
      href={`mailto:${artist.email}?subject=${encodeURIComponent(subject)}`}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
    >
      {site.homeContactEmailButton[lang]}
    </a>
    <a
      href={`tel:${artist.phoneRaw}`}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    >
      {site.homeContactPhoneButton[lang]}
    </a>
  </p>
</section>
