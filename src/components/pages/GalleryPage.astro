---
import { getCollection } from "astro:content";
import ArtworkCard from "../ArtworkCard.astro";
import { t, type Lang } from "../../i18n/ui";
import { artist } from "../../data/settings";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = await getCollection("artworks");
const sorted = all.sort((a, b) => a.data.order - b.data.order);
const northart =
  artist.social.find((s) => s.label === "NorthArt")?.url ??
  "https://shop.northart.no";
---

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 md:pt-20 pb-8 sm:pb-12"
>
  <h1 class="font-display text-[clamp(2.25rem,7vw,4rem)] mb-5 sm:mb-6">
    {t(lang, "gallery.title")}
  </h1>
  <p
    class="max-w-[var(--container-prose)] text-base sm:text-lg text-[var(--color-muted)]"
  >
    {t(lang, "gallery.intro")}
  </p>
</section>

<section class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pb-16 sm:pb-24">
  {
    sorted.length === 0 ? (
      <p class="text-[var(--color-muted)]">{t(lang, "gallery.empty")}</p>
    ) : (
      <ul class="grid gap-x-4 sm:gap-x-6 gap-y-10 sm:gap-y-12 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
        {sorted.map((artwork) => (
          <li>
            <ArtworkCard artwork={artwork} lang={lang} />
          </li>
        ))}
      </ul>
    )
  }

  <p
    class="mt-16 sm:mt-20 pt-10 border-t border-[var(--color-border)] text-center"
  >
    <a
      href={northart}
      rel="noopener"
      target="_blank"
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    >
      {t(lang, "buy.northart")} ↗
    </a>
  </p>
</section>
