---
import { routes, type Lang } from "../../i18n/ui";
import {
  getArtistInfo,
  getSiteContent,
  bio,
  memberships,
} from "../../sanity/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = routes[lang];

const [artist, site] = await Promise.all([getArtistInfo(), getSiteContent()]);
const paragraphs = bio(artist, lang);
---

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 md:pt-20 pb-8 sm:pb-12"
>
  <h1 class="font-display text-[clamp(2.25rem,7vw,4rem)] mb-8 sm:mb-10">
    {artist.aboutHeading[lang]}
  </h1>
  <div
    class="max-w-[var(--container-prose)] space-y-5 text-base sm:text-lg text-[var(--color-text)]"
  >
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</section>

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-[var(--color-border)] grid gap-10 sm:gap-12 md:grid-cols-2"
>
  <div>
    <h2 class="font-display text-xl sm:text-2xl mb-5 sm:mb-6">
      {artist.educationTitle[lang]}
    </h2>
    <ul class="space-y-3 list-none p-0">
      {
        artist.education.map((row) => (
          <li class="grid grid-cols-[7rem_1fr] gap-4 text-sm">
            <span class="text-[var(--color-muted)] tabular-nums">
              {row.years}
            </span>
            <span>{row.text[lang]}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <h2 class="font-display text-xl sm:text-2xl mb-5 sm:mb-6">
      {artist.careerTitle[lang]}
    </h2>
    <ul class="space-y-3 list-none p-0 mb-12">
      {
        artist.career.map((row) => (
          <li class="grid grid-cols-[7rem_1fr] gap-4 text-sm">
            <span class="text-[var(--color-muted)] tabular-nums">
              {row.years}
            </span>
            <span>{row.text[lang]}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="font-display text-xl sm:text-2xl mb-5 sm:mb-6">
      {artist.membershipsTitle[lang]}
    </h2>
    <ul class="space-y-2 list-none p-0 text-sm">
      {memberships(artist, lang).map((m) => <li>{m}</li>)}
    </ul>
  </div>
</section>

<section
  class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-[var(--color-border)]"
>
  <p class="flex flex-wrap gap-3 sm:gap-4">
    <a
      href={r.artworks}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
    >
      {site.heroCtaPrimary[lang]}
    </a>
    <a
      href={r.contact}
      class="inline-flex items-center justify-center min-h-12 px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
    >
      {site.heroCtaSecondary[lang]}
    </a>
  </p>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: artist.name,
    birthPlace: artist.birthplace,
    birthDate: String(artist.born),
    email: artist.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: artist.addressStreet,
      postalCode: artist.addressPostalCode,
      addressLocality: artist.addressCity,
      addressCountry: "NO",
    },
    jobTitle: lang === "no" ? "Billedkunstner" : "Visual artist",
    sameAs: artist.social.map((s) => s.url),
  })}
  is:inline
/>
