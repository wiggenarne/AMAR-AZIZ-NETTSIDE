---
import { t, routes, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = routes[lang];
const otherLang: Lang = lang === "no" ? "en" : "no";
const otherHome = routes[otherLang].home;
---

<header
  class="border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur sticky top-0 z-30"
>
  <div
    class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-4 sm:py-5 flex items-center justify-between gap-4"
  >
    <p class="font-display text-xl tracking-tight">
      <a
        href={r.home}
        class="no-underline hover:text-[var(--color-accent)] inline-block py-2 -my-2"
      >
        Amar Aziz
      </a>
    </p>

    <nav
      aria-label={lang === "no" ? "Hovedmeny" : "Main menu"}
      class="hidden md:block"
    >
      <ul class="flex items-center gap-6 lg:gap-7 text-sm">
        <li><a href={r.artworks} class="no-underline py-2 inline-block">{t(lang, "nav.artworks")}</a></li>
        <li><a href={r.series} class="no-underline py-2 inline-block">{t(lang, "nav.series")}</a></li>
        <li><a href={r.about} class="no-underline py-2 inline-block">{t(lang, "nav.about")}</a></li>
        <li><a href={r.exhibitions} class="no-underline py-2 inline-block">{t(lang, "nav.exhibitions")}</a></li>
        <li><a href={r.contact} class="no-underline py-2 inline-block">{t(lang, "nav.contact")}</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-3 sm:gap-4">
      <p class="flex items-center gap-2 text-xs uppercase tracking-widest">
        <a
          href={r.home}
          aria-current={lang === "no" ? "page" : undefined}
          class:list={[
            "no-underline px-2 py-2",
            lang === "no" && "text-[var(--color-accent)]",
          ]}
          lang="no"
          hreflang="no"
        >
          NO
        </a>
        <span aria-hidden="true" class="text-[var(--color-muted)]">/</span>
        <a
          href={otherHome}
          aria-current={lang === "en" ? "page" : undefined}
          class:list={[
            "no-underline px-2 py-2",
            lang === "en" && "text-[var(--color-accent)]",
          ]}
          lang="en"
          hreflang="en"
        >
          EN
        </a>
      </p>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(lang, "menu.open")}
        data-label-open={t(lang, "menu.open")}
        data-label-close={t(lang, "menu.close")}
        class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 border border-[var(--color-border)] hover:border-[var(--color-text)] transition-colors"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          class="block"
        >
          <path
            class="menu-icon-open"
            d="M3 6h18M3 12h18M3 18h18"
            stroke-linecap="round"
          ></path>
          <path
            class="menu-icon-close hidden"
            d="M6 6l12 12M18 6L6 18"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label={lang === "no" ? "Mobil-meny" : "Mobile menu"}
    hidden
    class="md:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]"
  >
    <ul class="px-4 sm:px-6 py-4 space-y-1 text-base">
      <li><a href={r.home} class="block no-underline px-2 py-3 min-h-12 flex items-center">{t(lang, "nav.home")}</a></li>
      <li><a href={r.artworks} class="block no-underline px-2 py-3 min-h-12 flex items-center">{t(lang, "nav.artworks")}</a></li>
      <li><a href={r.series} class="block no-underline px-2 py-3 min-h-12 flex items-center">{t(lang, "nav.series")}</a></li>
      <li><a href={r.about} class="block no-underline px-2 py-3 min-h-12 flex items-center">{t(lang, "nav.about")}</a></li>
      <li><a href={r.exhibitions} class="block no-underline px-2 py-3 min-h-12 flex items-center">{t(lang, "nav.exhibitions")}</a></li>
      <li><a href={r.contact} class="block no-underline px-2 py-3 min-h-12 flex items-center">{t(lang, "nav.contact")}</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  const iconOpen = document.querySelector(".menu-icon-open");
  const iconClose = document.querySelector(".menu-icon-close");

  if (toggle && nav && iconOpen && iconClose) {
    const labelOpen = toggle.getAttribute("data-label-open") ?? "";
    const labelClose = toggle.getAttribute("data-label-close") ?? "";

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      const next = !isOpen;
      toggle.setAttribute("aria-expanded", String(next));
      toggle.setAttribute("aria-label", next ? labelClose : labelOpen);
      if (next) {
        nav.removeAttribute("hidden");
        iconOpen.classList.add("hidden");
        iconClose.classList.remove("hidden");
      } else {
        nav.setAttribute("hidden", "");
        iconOpen.classList.remove("hidden");
        iconClose.classList.add("hidden");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        toggle.click();
        toggle.focus();
      }
    });
  }
</script>
