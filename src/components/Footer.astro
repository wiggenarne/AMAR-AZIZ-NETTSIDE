---
import { t, routes, type Lang } from "../i18n/ui";
import { getArtistInfo, getSiteContent } from "../sanity/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = routes[lang];
const year = new Date().getFullYear();

const [artist, site] = await Promise.all([getArtistInfo(), getSiteContent()]);
---

<footer
  class="mt-24 border-t border-[var(--color-border)] bg-[var(--color-surface)]"
>
  <div
    class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-10 sm:py-14 grid gap-8 sm:gap-10 sm:grid-cols-2 lg:grid-cols-3"
  >
    <address class="not-italic space-y-1 text-sm">
      <p class="font-display text-lg">{artist.name}</p>
      <p class="text-[var(--color-muted)]">
        {artist.addressStreet}, {artist.addressPostalCode} {artist.addressCity}
      </p>
      <p>
        <a href={`mailto:${artist.email}`}>{artist.email}</a>
      </p>
    </address>

    <nav aria-label={lang === "no" ? "Bunnmeny" : "Footer menu"}>
      <ul class="space-y-2 text-sm">
        <li><a href={r.artworks}>{t(lang, "nav.artworks")}</a></li>
        <li><a href={r.series}>{t(lang, "nav.series")}</a></li>
        <li><a href={r.about}>{t(lang, "nav.about")}</a></li>
        <li><a href={r.exhibitions}>{t(lang, "nav.exhibitions")}</a></li>
        <li><a href={r.contact}>{t(lang, "nav.contact")}</a></li>
      </ul>
    </nav>

    <ul class="space-y-2 text-sm sm:col-span-2 lg:col-span-1">
      {
        artist.social.map((s) => (
          <li>
            <a href={s.url} rel="me noopener">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <p
      class="max-w-[var(--container-page)] mx-auto px-4 sm:px-6 py-5 text-xs text-[var(--color-muted)]"
    >
      © {year} {artist.name}. {site.footerRights[lang]}
    </p>
  </div>
</footer>
