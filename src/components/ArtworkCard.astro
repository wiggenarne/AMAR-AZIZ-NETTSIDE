---
import { type Lang, routes } from "../i18n/ui";
import type { ArtworkEntry } from "../sanity/content";

interface Props {
  artwork: ArtworkEntry;
  lang: Lang;
}

const { artwork, lang } = Astro.props;
const r = routes[lang];
const data = artwork.data;
const title = data.title[lang];
const medium = data.medium[lang];
const dim = `${data.width_cm} × ${data.height_cm} cm`;
const altText = `${title}, ${medium}, ${data.year}, ${dim}`;
---

<article>
  <a
    href={`${r.artworks}/${artwork.id}`}
    class="block no-underline group"
    aria-label={altText}
  >
    <figure class="m-0">
      <div class="aspect-square w-full overflow-hidden bg-[var(--color-border)]">
        <img
          src={data.image}
          alt={altText}
          loading="lazy"
          decoding="async"
          width="800"
          height="800"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          onerror="this.style.display='none';this.parentElement.dataset.placeholder='1'"
        />
      </div>
      <figcaption class="mt-3 space-y-1">
        <h3 class="font-display text-base leading-tight">{title}</h3>
        <p class="text-sm text-[var(--color-muted)]">
          {medium} · {data.year} · {dim}
        </p>
        {
          !data.available && (
            <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">
              {lang === "no" ? "Solgt" : "Sold"}
            </p>
          )
        }
      </figcaption>
    </figure>
  </a>
</article>

<style>
  div[data-placeholder="1"] {
    display: grid;
    place-items: center;
  }
  div[data-placeholder="1"]::after {
    content: "—";
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 2rem;
  }
</style>
