---
import { type Lang } from "../i18n/ui";
import { getArtistInfo } from "../sanity/content";

interface Props {
  lang: Lang;
  title: string;
  year: number;
  medium: string;
  dimensions: string;
  url: string;
  available: boolean;
  salesUrl?: string;
}

const {
  lang,
  title,
  year,
  medium,
  dimensions,
  url,
  available,
  salesUrl,
} = Astro.props;

const artist = await getArtistInfo();

const labels = {
  no: {
    inquire: "Forespør pris",
    buyExternal: "Kjøp på NorthArt →",
    sold: "Solgt – kontakt for liknende",
    call: "Ring kunstneren",
  },
  en: {
    inquire: "Inquire about price",
    buyExternal: "Buy on NorthArt →",
    sold: "Sold – contact for similar",
    call: "Call the artist",
  },
};

const subject =
  lang === "no"
    ? `Forespørsel: «${title}» (${year})`
    : `Inquiry: "${title}" (${year})`;

const body =
  lang === "no"
    ? `Hei Amar,\n\nJeg er interessert i verket «${title}» (${medium}, ${dimensions}, ${year}).\nLenke: ${url}\n\nVennlig hilsen,\n`
    : `Hello Amar,\n\nI'm interested in the work "${title}" (${medium}, ${dimensions}, ${year}).\nLink: ${url}\n\nKind regards,\n`;

const mailto = `mailto:${artist.email}?subject=${encodeURIComponent(
  subject,
)}&body=${encodeURIComponent(body)}`;

const useSalesUrl = available && Boolean(salesUrl);
const primaryHref = useSalesUrl ? (salesUrl as string) : mailto;
const primaryLabel = !available
  ? labels[lang].sold
  : useSalesUrl
    ? labels[lang].buyExternal
    : labels[lang].inquire;
const primaryExternal = useSalesUrl;
---

<p class="flex flex-wrap gap-3">
  <a
    href={primaryHref}
    class="inline-flex items-center justify-center min-h-12 px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
    {...primaryExternal
      ? { target: "_blank", rel: "noopener noreferrer" }
      : {}}
  >
    {primaryLabel}
  </a>
  <a
    href={`tel:${artist.phoneRaw}`}
    class="inline-flex items-center justify-center min-h-12 px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
  >
    {labels[lang].call}
  </a>
</p>
