---
import { type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  year: number;
  medium: string;
  dimensions: string;
  url: string;
  available: boolean;
}

const { lang, title, year, medium, dimensions, url, available } = Astro.props;

const labels = {
  no: {
    inquire: "Forespør pris",
    sold: "Solgt – kontakt for liknende",
    call: "Ring kunstneren",
  },
  en: {
    inquire: "Inquire about price",
    sold: "Sold – contact for similar",
    call: "Call the artist",
  },
};

const subject =
  lang === "no"
    ? `Forespørsel: «${title}» (${year})`
    : `Inquiry: "${title}" (${year})`;

const body =
  lang === "no"
    ? `Hei Amar,\n\nJeg er interessert i verket «${title}» (${medium}, ${dimensions}, ${year}).\nLenke: ${url}\n\nVennlig hilsen,\n`
    : `Hello Amar,\n\nI'm interested in the work "${title}" (${medium}, ${dimensions}, ${year}).\nLink: ${url}\n\nKind regards,\n`;

const mailto = `mailto:amar260651@gmail.com?subject=${encodeURIComponent(
  subject,
)}&body=${encodeURIComponent(body)}`;

const primaryLabel = available ? labels[lang].inquire : labels[lang].sold;
---

<p class="flex flex-wrap gap-3">
  <a
    href={mailto}
    class="inline-block px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
  >
    {primaryLabel}
  </a>
  <a
    href="tel:+47"
    class="inline-block px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
  >
    {labels[lang].call}
  </a>
</p>
