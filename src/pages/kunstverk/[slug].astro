---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArtworkDetail from "../../components/pages/ArtworkDetail.astro";
import { getAllArtworks } from "../../lib/queries";
import { pickLocale } from "../../lib/sanity";

export async function getStaticPaths() {
  const artworks = await getAllArtworks();
  return artworks.map((artwork) => ({
    params: { slug: artwork.slug },
    props: { artwork },
  }));
}

const { artwork } = Astro.props;
const lang = "no";
const title = pickLocale(artwork.title, lang);
const description = pickLocale(artwork.description, lang);
---

<BaseLayout
  title={`${title} – Amar Aziz`}
  description={description}
  lang={lang}
>
  <ArtworkDetail artwork={artwork} lang={lang} />
</BaseLayout>
