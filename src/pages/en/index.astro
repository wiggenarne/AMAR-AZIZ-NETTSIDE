---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePage from "../../components/pages/HomePage.astro";
import { getSiteContent } from "../../sanity/content";

const lang = "en";
const site = await getSiteContent();
---

<BaseLayout
  title={site.siteTitle[lang]}
  description={site.siteDescription[lang]}
  lang={lang}
>
  <HomePage lang={lang} />
</BaseLayout>
