---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArtworkDetail from "../../../components/pages/ArtworkDetail.astro";

export async function getStaticPaths() {
  const artworks = await getCollection("artworks");
  return artworks.map((artwork) => ({
    params: { slug: artwork.id },
    props: { artwork },
  }));
}

const { artwork } = Astro.props;
const lang = "en";
const title = artwork.data.title[lang];
const description = artwork.data.description[lang];
---

<BaseLayout
  title={`${title} – Amar Aziz`}
  description={description}
  lang={lang}
>
  <ArtworkDetail artwork={artwork} lang={lang} />
</BaseLayout>
