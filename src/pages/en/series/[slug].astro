---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SeriesDetail from "../../../components/pages/SeriesDetail.astro";
import { getAllSeries } from "../../../lib/queries";
import { pickLocale } from "../../../lib/sanity";

export async function getStaticPaths() {
  const series = await getAllSeries();
  return series.map((s) => ({
    params: { slug: s.slug },
    props: { series: s },
  }));
}

const { series } = Astro.props;
const lang = "en";
const title = pickLocale(series.title, lang);
const description = pickLocale(series.statement, lang);
---

<BaseLayout
  title={`${title} – Amar Aziz`}
  description={description}
  lang={lang}
>
  <SeriesDetail series={series} lang={lang} />
</BaseLayout>
