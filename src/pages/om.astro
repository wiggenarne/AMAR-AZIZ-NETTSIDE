---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutPage from "../components/pages/AboutPage.astro";
import { getArtistInfo, bio } from "../sanity/content";

const lang = "no" as const;
const artist = await getArtistInfo();
const firstBioParagraph = bio(artist, lang)[0] ?? "";
---

<BaseLayout
  title={`${artist.aboutHeading[lang]} – ${artist.name}`}
  description={firstBioParagraph}
  lang={lang}
>
  <AboutPage lang={lang} />
</BaseLayout>
