---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutPage from "../components/pages/AboutPage.astro";
import { t } from "../i18n/ui";
import { artist, bio } from "../data/settings";

const lang = "no";
---

<BaseLayout
  title={`${t(lang, "about.heading")} – ${artist.name}`}
  description={bio[lang][0]}
  lang={lang}
>
  <AboutPage lang={lang} />
</BaseLayout>
