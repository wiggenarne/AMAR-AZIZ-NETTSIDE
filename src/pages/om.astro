---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, routes } from "../i18n/ui";
import { artist, bio, cv } from "../data/settings";

const lang = "no";
const r = routes[lang];
const paragraphs = bio[lang];
const cvData = cv[lang];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: artist.name,
  birthPlace: artist.birthplace,
  birthDate: String(artist.born),
  email: artist.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: artist.address.street,
    postalCode: artist.address.postalCode,
    addressLocality: artist.address.city,
    addressCountry: "NO",
  },
  jobTitle: lang === "no" ? "Billedkunstner" : "Visual artist",
  sameAs: artist.social.map((s) => s.url),
};
---

<BaseLayout
  title={`${t(lang, "about.heading")} – ${artist.name}`}
  description={paragraphs[0]}
  lang={lang}
>
  <section
    class="max-w-[var(--container-page)] mx-auto px-6 pt-16 md:pt-20 pb-12"
  >
    <h1 class="font-display text-4xl md:text-6xl mb-10">
      {t(lang, "about.heading")}
    </h1>
    <div
      class="max-w-[var(--container-prose)] space-y-5 text-lg text-[var(--color-text)]"
    >
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section
    class="max-w-[var(--container-page)] mx-auto px-6 py-16 border-t border-[var(--color-border)] grid gap-12 md:grid-cols-2"
  >
    <div>
      <h2 class="font-display text-2xl mb-6">
        {t(lang, "about.cv.education")}
      </h2>
      <ul class="space-y-3 list-none p-0">
        {
          cvData.education.map((row) => (
            <li class="grid grid-cols-[7rem_1fr] gap-4 text-sm">
              <span class="text-[var(--color-muted)] tabular-nums">
                {row.years}
              </span>
              <span>{row.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="font-display text-2xl mb-6">{t(lang, "about.cv.career")}</h2>
      <ul class="space-y-3 list-none p-0 mb-12">
        {
          cvData.career.map((row) => (
            <li class="grid grid-cols-[7rem_1fr] gap-4 text-sm">
              <span class="text-[var(--color-muted)] tabular-nums">
                {row.years}
              </span>
              <span>{row.text}</span>
            </li>
          ))
        }
      </ul>

      <h2 class="font-display text-2xl mb-6">
        {t(lang, "about.cv.memberships")}
      </h2>
      <ul class="space-y-2 list-none p-0 text-sm">
        {cvData.memberships.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <section
    class="max-w-[var(--container-page)] mx-auto px-6 py-16 border-t border-[var(--color-border)]"
  >
    <p class="flex flex-wrap gap-4">
      <a
        href={r.artworks}
        class="inline-block px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
      >
        {t(lang, "hero.cta.primary")}
      </a>
      <a
        href={r.contact}
        class="inline-block px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
      >
        {t(lang, "hero.cta.secondary")}
      </a>
    </p>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    is:inline
  />
</BaseLayout>
