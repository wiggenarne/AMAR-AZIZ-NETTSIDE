---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";

const lang = "no";

const all = await getCollection("exhibitions");
const sorted = all.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);

type Group = { year: number; items: typeof sorted };
const grouped: Group[] = [];
for (const ex of sorted) {
  const year = ex.data.startDate.getFullYear();
  let g = grouped.find((x) => x.year === year);
  if (!g) {
    g = { year, items: [] };
    grouped.push(g);
  }
  g.items.push(ex);
}

const fmt = (d: Date) =>
  d.toLocaleDateString(lang === "no" ? "nb-NO" : "en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<BaseLayout
  title={`${t(lang, "exhibitions.title")} – Amar Aziz`}
  description={t(lang, "exhibitions.intro")}
  lang={lang}
>
  <section
    class="max-w-[var(--container-page)] mx-auto px-6 pt-16 md:pt-20 pb-12"
  >
    <h1 class="font-display text-4xl md:text-6xl mb-6">
      {t(lang, "exhibitions.title")}
    </h1>
    <p
      class="max-w-[var(--container-prose)] text-lg text-[var(--color-muted)]"
    >
      {t(lang, "exhibitions.intro")}
    </p>
  </section>

  <section
    class="max-w-[var(--container-page)] mx-auto px-6 pb-24"
  >
    {
      grouped.length === 0 ? (
        <p class="text-[var(--color-muted)]">{t(lang, "exhibitions.empty")}</p>
      ) : (
        grouped.map((g) => (
          <div class="border-t border-[var(--color-border)] py-10">
            <h2 class="font-display text-3xl mb-8 tabular-nums">{g.year}</h2>
            <ul class="space-y-8 list-none p-0">
              {g.items.map((ex) => (
                <li>
                  <article class="grid gap-2 md:grid-cols-[12rem_1fr] md:gap-8">
                    <p class="text-sm text-[var(--color-muted)] tabular-nums">
                      {fmt(ex.data.startDate)}
                      {ex.data.endDate ? ` – ${fmt(ex.data.endDate)}` : ""}
                    </p>
                    <div>
                      <h3 class="font-display text-xl mb-1">
                        {ex.data.link ? (
                          <a href={ex.data.link} rel="noopener" target="_blank">
                            {ex.data.title[lang]}
                          </a>
                        ) : (
                          ex.data.title[lang]
                        )}
                      </h3>
                      <p class="text-sm text-[var(--color-muted)]">
                        {ex.data.venue}, {ex.data.city}
                        {" · "}
                        {t(
                          lang,
                          ex.data.type === "solo"
                            ? "exhibitions.solo"
                            : "exhibitions.group",
                        )}
                      </p>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </div>
        ))
      )
    }
  </section>
</BaseLayout>
