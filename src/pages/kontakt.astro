---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactPage from "../components/pages/ContactPage.astro";
import { getArtistInfo } from "../sanity/content";

const lang = "no" as const;
const artist = await getArtistInfo();
---

<BaseLayout
  title={`${artist.contactHeading[lang]} – ${artist.name}`}
  description={artist.contactIntro[lang]}
  lang={lang}
>
  <ContactPage lang={lang} />
</BaseLayout>
