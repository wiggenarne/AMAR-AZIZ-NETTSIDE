---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import { artist } from "../data/settings";

const lang = "no";
const subject =
  lang === "no" ? "Forespørsel om kunstverk" : "Artwork inquiry";
const mailto = `mailto:${artist.email}?subject=${encodeURIComponent(subject)}`;
---

<BaseLayout
  title={`${t(lang, "contact.heading")} – Amar Aziz`}
  description={t(lang, "contact.body")}
  lang={lang}
>
  <section
    class="max-w-[var(--container-page)] mx-auto px-6 pt-16 md:pt-20 pb-12"
  >
    <h1 class="font-display text-4xl md:text-6xl mb-6">
      {t(lang, "contact.heading")}
    </h1>
    <p
      class="max-w-[var(--container-prose)] text-lg text-[var(--color-muted)] mb-10"
    >
      {t(lang, "contact.body")}
    </p>

    <p class="flex flex-wrap gap-4">
      <a
        href={mailto}
        class="inline-block px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
      >
        {t(lang, "contact.email")}
      </a>
      <a
        href={`tel:${artist.phone}`}
        class="inline-block px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
      >
        {t(lang, "contact.phone")}
      </a>
    </p>
  </section>

  <section
    class="max-w-[var(--container-page)] mx-auto px-6 py-16 border-t border-[var(--color-border)] grid gap-12 md:grid-cols-3"
  >
    <div>
      <h2
        class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
      >
        {t(lang, "contact.email.label")}
      </h2>
      <p class="font-display text-lg">
        <a href={`mailto:${artist.email}`}>{artist.email}</a>
      </p>
    </div>

    <div>
      <h2
        class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
      >
        {t(lang, "contact.phone.label")}
      </h2>
      <p class="font-display text-lg">
        <a href={`tel:${artist.phone}`}>{artist.phone}</a>
      </p>
    </div>

    <address class="not-italic">
      <h2
        class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
      >
        {t(lang, "contact.address")}
      </h2>
      <p class="font-display text-lg leading-snug">
        {artist.name}<br />
        {artist.address.street}<br />
        {artist.address.postalCode} {artist.address.city}<br />
        {artist.address.country}
      </p>
    </address>
  </section>

  <section
    class="max-w-[var(--container-page)] mx-auto px-6 py-16 border-t border-[var(--color-border)]"
  >
    <h2
      class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-4"
    >
      {t(lang, "contact.social")}
    </h2>
    <ul class="flex flex-wrap gap-6 list-none p-0">
      {
        artist.social.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
