---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, routes } from "../i18n/ui";

const lang = "no";
const r = routes[lang];

const series = [
  {
    slug: "steps-to-paradise",
    title: "Steps to Paradise",
    description: "En kubistisk meditasjon over reisen mot lyset.",
  },
  {
    slug: "aluminium",
    title: "Aluminium-serien",
    description: "Digitale motiver trykket på børstet aluminium.",
  },
  {
    slug: "portretter",
    title: "Portretter",
    description: "Kubistiske studier av ansikt og form.",
  },
];

const latest = [
  {
    slug: "verk-1",
    title: "Verk 1",
    medium: "Akryl på lerret",
    year: 2025,
    size: "80 × 80 cm",
    image: "/images/artworks/verk-1.jpg",
  },
  {
    slug: "verk-2",
    title: "Verk 2",
    medium: "Aluminium",
    year: 2024,
    size: "100 × 100 cm",
    image: "/images/artworks/verk-2.jpg",
  },
  {
    slug: "verk-3",
    title: "Verk 3",
    medium: "Akryl på lerret",
    year: 2024,
    size: "60 × 80 cm",
    image: "/images/artworks/verk-3.jpg",
  },
  {
    slug: "verk-4",
    title: "Verk 4",
    medium: "Akryl på lerret",
    year: 2023,
    size: "100 × 120 cm",
    image: "/images/artworks/verk-4.jpg",
  },
];
---

<BaseLayout
  title={t(lang, "site.title")}
  description={t(lang, "site.description")}
  lang={lang}
>
  <section
    aria-labelledby="hero-tittel"
    class="max-w-[var(--container-page)] mx-auto px-6 pt-16 md:pt-24 pb-20"
  >
    <p
      class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-6"
    >
      {t(lang, "hero.eyebrow")}
    </p>
    <h1
      id="hero-tittel"
      class="font-display text-5xl md:text-7xl lg:text-8xl leading-[0.95] tracking-tight mb-8"
    >
      Amar Aziz
    </h1>
    <p
      class="max-w-[var(--container-prose)] text-lg md:text-xl text-[var(--color-muted)] mb-10"
    >
      {t(lang, "hero.lede")}
    </p>

    <figure class="mb-10">
      <div
        class="aspect-square w-full bg-[var(--color-border)] grid place-items-center text-[var(--color-muted)] text-sm"
      >
        {/* Bilde plasseres her i Fase 3 */}
        <span>Mountain &amp; Light – 100 × 100 cm</span>
      </div>
      <figcaption
        class="mt-3 text-sm text-[var(--color-muted)] font-display italic"
      >
        Mountain &amp; Light, 2016 – børstet aluminium, 100 × 100 cm
      </figcaption>
    </figure>

    <p class="flex flex-wrap gap-4">
      <a
        href={r.artworks}
        class="inline-block px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
      >
        {t(lang, "hero.cta.primary")}
      </a>
      <a
        href={r.contact}
        class="inline-block px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
      >
        {t(lang, "hero.cta.secondary")}
      </a>
    </p>
  </section>

  <section
    aria-labelledby="om-tittel"
    class="max-w-[var(--container-page)] mx-auto px-6 py-20 border-t border-[var(--color-border)]"
  >
    <h2
      id="om-tittel"
      class="font-display text-3xl md:text-4xl mb-6"
    >
      {t(lang, "about.title")}
    </h2>
    <p
      class="max-w-[var(--container-prose)] text-lg text-[var(--color-muted)] mb-6"
    >
      {t(lang, "about.body")}
    </p>
    <p>
      <a href={r.about}>{t(lang, "about.more")} →</a>
    </p>
  </section>

  <section
    aria-labelledby="serier-tittel"
    class="max-w-[var(--container-page)] mx-auto px-6 py-20 border-t border-[var(--color-border)]"
  >
    <h2 id="serier-tittel" class="font-display text-3xl md:text-4xl mb-10">
      {t(lang, "series.title")}
    </h2>
    <ul class="grid gap-8 md:grid-cols-3 list-none p-0">
      {
        series.map((s) => (
          <li>
            <article class="space-y-2">
              <h3 class="font-display text-xl">
                <a href={`${r.series}/${s.slug}`} class="no-underline">
                  {s.title}
                </a>
              </h3>
              <p class="text-[var(--color-muted)]">{s.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    aria-labelledby="siste-tittel"
    class="max-w-[var(--container-page)] mx-auto px-6 py-20 border-t border-[var(--color-border)]"
  >
    <h2 id="siste-tittel" class="font-display text-3xl md:text-4xl mb-10">
      {t(lang, "latest.title")}
    </h2>
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 list-none p-0">
      {
        latest.map((w) => (
          <li>
            <article>
              <a
                href={`${r.artworks}/${w.slug}`}
                class="no-underline block group"
              >
                <figure>
                  <div class="aspect-square w-full bg-[var(--color-border)] grid place-items-center text-[var(--color-muted)] text-xs group-hover:opacity-80 transition-opacity">
                    {w.title}
                  </div>
                  <figcaption class="mt-3">
                    <h3 class="font-display text-base">{w.title}</h3>
                    <p class="text-sm text-[var(--color-muted)] mt-1">
                      {w.medium} · {w.year} · {w.size}
                    </p>
                  </figcaption>
                </figure>
              </a>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="mt-10">
      <a href={r.artworks}>{t(lang, "latest.viewAll")} →</a>
    </p>
  </section>

  <section
    aria-labelledby="kontakt-tittel"
    class="max-w-[var(--container-page)] mx-auto px-6 py-20 border-t border-[var(--color-border)]"
  >
    <h2 id="kontakt-tittel" class="font-display text-3xl md:text-4xl mb-6">
      {t(lang, "contact.title")}
    </h2>
    <p
      class="max-w-[var(--container-prose)] text-lg text-[var(--color-muted)] mb-8"
    >
      {t(lang, "contact.body")}
    </p>
    <p class="flex flex-wrap gap-4">
      <a
        href="mailto:amar260651@gmail.com?subject=Foresp%C3%B8rsel%20om%20kunstverk"
        class="inline-block px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
      >
        {t(lang, "contact.email")}
      </a>
      <a
        href="tel:+47"
        class="inline-block px-6 py-3 border border-[var(--color-text)] no-underline hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
      >
        {t(lang, "contact.phone")}
      </a>
    </p>
  </section>
</BaseLayout>
