---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, routes } from "../i18n/ui";

const lang = "no";
const r = routes[lang];
---

<BaseLayout
  title={`${t(lang, "404.title")} – Amar Aziz`}
  description={t(lang, "404.body")}
  lang={lang}
>
  <section
    class="max-w-[var(--container-page)] mx-auto px-6 pt-24 md:pt-32 pb-32 text-center"
  >
    <p
      class="text-xs uppercase tracking-[0.25em] text-[var(--color-muted)] mb-6"
    >
      404
    </p>
    <h1 class="font-display text-4xl md:text-6xl mb-6">
      {t(lang, "404.title")}
    </h1>
    <p
      class="max-w-[var(--container-prose)] mx-auto text-lg text-[var(--color-muted)] mb-10"
    >
      {t(lang, "404.body")}
    </p>
    <p>
      <a
        href={r.home}
        class="inline-block px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] no-underline hover:bg-[var(--color-accent)] transition-colors"
      >
        {t(lang, "404.cta")}
      </a>
    </p>
  </section>
</BaseLayout>
